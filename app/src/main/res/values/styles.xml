<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Stile per TextInputLayout moderno -->
    <style name="ModernTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="hintTextColor">@color/accent_red</item>
        <item name="boxStrokeColor">@color/accent_red</item>
        <item name="boxStrokeErrorColor">@color/accent_red_dark</item>
    </style>

    <!-- Stile per Dropdown moderno -->
    <style name="ModernDropdownLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="hintTextColor">@color/accent_red</item>
        <item name="boxStrokeColor">@color/accent_red</item>
        <item name="endIconTint">@color/accent_red</item>
    </style>

    <!-- Pulsante primario -->
    <style name="ModernPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_red</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/accent_red_light</item>
    </style>

    <!-- Pulsante outline -->
    <style name="ModernOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_red</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/accent_red</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/accent_red_alpha</item>
        <item name="iconTint">@color/accent_red</item>
    </style>

    <!-- Stile per l'indicatore attivo della bottom nav -->
    <style name="ModernBottomNavIndicator">
        <item name="android:color">@color/fui_transparent</item>
    </style>

    <!-- Testo attivo bottom nav -->
    <style name="ModernBottomNavTextActive">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Testo inattivo bottom nav -->
    <style name="ModernBottomNavTextInactive">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>

</resources>
